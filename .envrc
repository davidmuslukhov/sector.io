# Activate the project venv (created/updated by setup_env.sh or uv sync).
# Install direnv hook once: eval "$(direnv hook zsh)"  # or bash/fish
# Then: direnv allow

if ! has uv; then
  echo "uv not found. Install: https://docs.astral.sh/uv/getting-started/installation/" >&2
  return 1
fi

watch_file pyproject.toml
watch_file uv.lock
watch_file .python-version

uv sync --quiet
source .venv/bin/activate
